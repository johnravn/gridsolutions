{
  "name": "Grid",
  "install": "bash scripts/cloud-agent-install.sh",
  "start": "bash scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "npm run dev",
      "description": "Vite on :3000. Start script prefers hosted Dev secrets; falls back to Docker Supabase."
