# Copy to .env.local (active target Vite reads) — never commit real keys.
# Prefer profile files + npm run db:switch:{dev|local|prod}

# --- Active app target (example: hosted Dev) ---
VITE_SUPABASE_URL=https://YOUR_DEV_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY
SUPABASE_PROJECT_REF=YOUR_DEV_REF

# Server-only (local API middleware / scripts). Never put service_role in client bundles.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY

# Optional: Conta / Maps / cron (see ENVIRONMENT_SETUP.md)
# VITE_GOOGLE_MAPS_PLATFORM_API_KEY=
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Profile files (gitignored) — create via switch or by hand:
#
#   .env.dev.db     → hosted Dev   (npm run db:switch:dev)
#   .env.remote.db  → hosted Prod  (npm run db:switch:prod)  [legacy name]
#   .env.local.db   → Docker       (npm run db:switch:local)
#
# Prod project ref (do not use as default for agents):
#   tlpgejkglrgoljgvpubn → https://tlpgejkglrgoljgvpubn.supabase.co
#
# Docker local:
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#
# Cursor cloud secrets (Dev only): same VITE_* + SUPABASE_PROJECT_REF +
# optional SUPABASE_SERVICE_ROLE_KEY. Never inject Prod service_role by default.
# ---------------------------------------------------------------------------
